int findMaximumXOR(int* nums, int numsSize) {
    int maxResult = 0;
    for (int i = 0; i < numsSize; i++) {
        for (int j = i + 1; j < numsSize; j++) {
            int currentXOR = nums[i] ^ nums[j];
            if (currentXOR > maxResult) {
                maxResult = currentXOR;
            }
        }
    }
    return maxResult;
}
