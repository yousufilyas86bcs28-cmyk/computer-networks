#include<stdio.h>
#include <stdio.h>
#define MAX 1000

int main()
{
    char str[100], outputStr[100];
    int data[MAX], stuffed[MAX], transmitted[MAX], received[MAX], destuffed[MAX];
    int n = 0, i, j = 0, ones = 0, k;

    printf("Enter a string: ");
    scanf("%s", str);


    for(i = 0; str[i] != '\0'; i++)
    {
        int val = (int)str[i];
        int binary[8];

        for(k = 7; k >= 0; k--)
        {
            binary[k] = val % 2;
            val = val / 2;
        }

        for(k = 0; k < 8; k++)
        {
            data[n++] = binary[k];
        }
    }

    printf("\nOriginal Data     : ");
    for(i = 0; i < n; i++)
        printf("%d", data[i]);


    ones = 0;
    j = 0;
    for(i = 0; i < n; i++)
    {
        stuffed[j++] = data[i];

        if(data[i] == 1)
            ones++;
        else
            ones = 0;

        if(ones == 5)
        {
            stuffed[j++] = 0;
            ones = 0;
        }
    }
    int stuffedLen = j;

    printf("\nStuffed Frame     : ");
    for(i = 0; i < stuffedLen; i++)
        printf("%d", stuffed[i]);


    int transLen = stuffedLen;
    int parityCount = 0;
    for(i = 0; i < stuffedLen; i++) {
        transmitted[i] = stuffed[i];
        if(stuffed[i] == 1) parityCount++;
    }

    if(parityCount%2==1){
       transmitted[transLen++]=1;
    }
    else{
       transmitted[transLen++]=0;
    }

    printf("\nTransmitted Frame : ");
    for(i = 0; i < transLen; i++)
        printf("%d", transmitted[i]);


    for(i = 0; i < transLen; i++) {
        received[i] = transmitted[i];
    }

    int choice;
    printf("\n\n--- Error Simulation Menu ---");
    printf("\n1. No Errors (Perfect Transmission)");
    printf("\n2. Introduce Single Bit Error");
    printf("\n3. Introduce Multiple Bit Errors");
    printf("\nSelect Option (1-3): ");
    scanf("%d", &choice);

    if (choice == 2) {
        received[stuffedLen / 2] ^= 1;
        printf(" Flipped 1 bit at index %d\n", stuffedLen / 2);
    }
    else if (choice == 3) {
        received[stuffedLen / 3] ^= 1;
        received[stuffedLen / 2] ^= 1;
        printf("Flipped 2 bits at indices %d and %d\n", stuffedLen / 3, stuffedLen / 2);
    }

    printf("\nReceived Frame    : ");
    for(i = 0; i < transLen; i++)
        printf("%d", received[i]);


    int receiverParityCount = 0;
    for(i = 0; i < transLen; i++) {
        if(received[i] == 1) receiverParityCount++;
    }
    int errorDetected = (receiverParityCount % 2 != 0);


    ones = 0;
    j = 0;
    int receivedPayloadLen = transLen - 1;

    for(i = 0; i < receivedPayloadLen; i++)
    {
        destuffed[j++] = received[i];

        if(received[i] == 1)
            ones++;
        else
            ones = 0;

        if(ones == 5)
        {

            if(i + 1 < receivedPayloadLen && received[i + 1] == 0) {
                i++;
            }
            ones = 0;
        }
    }
    int destuffedLen = j;

    printf("\nDestuffed Data    : ");
    for(i = 0; i < destuffedLen; i++)
        printf("%d", destuffed[i]);


    int charIndex = 0;
    for(i = 0; i < destuffedLen; i += 8)
    {
        int value = 0;
        for(k = 0; k < 8; k++)
        {
            if (i + k < destuffedLen) {
                value = value * 2 + destuffed[i + k];
            }
        }
        outputStr[charIndex++] = (char)value;
    }
    outputStr[charIndex] = '\0';

    printf("\nRecovered String  : %s", outputStr);
    printf("\nError Detection Status: ");
    if (errorDetected) {
        printf("ERROR DETECTED! Transmitted data contains errors.\n");
    } else {
        printf("SUCCESS! Transmitted data is received correctly.\n");
    }
    printf(" \n");

    return 0;
}
