/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
#include <stdio.h>

int* countBits(int n, int* returnSize) {
    
    *returnSize = n + 1;
    
    
    int* ans = (int*)malloc((*returnSize) * sizeof(int));
    if (ans == NULL) {
        return NULL; 
    }
    

    for (int i = 0; i <= n; i++) {
        int count = 0;
        int copy = i;
        
        
        while (copy > 0) {
            int rem = copy % 2;
            if (rem == 1) {
                count++;
            }
            copy = copy / 2; 
        }
        
        ans[i] = count;
    }
    
    return ans;
}
